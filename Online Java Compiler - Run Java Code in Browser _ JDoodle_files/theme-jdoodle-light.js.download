define("ace/theme/jdoodle-light", ["require", "exports", "module", "ace/lib/dom"], function (require, exports, module) {
  exports.isDark = false;
  exports.cssClass = "ace-jdoodle-light";
  exports.cssText = ".ace-jdoodle-light .ace_gutter {\
background: #fdfdfe;\
color: #64748b\
}\
.ace-jdoodle-light .ace_print-margin {\
width: 1px;\
background: #e8edf4\
}\
.ace-jdoodle-light {\
background-color: #fdfdfe;\
color: #1e293b\
}\
.ace-jdoodle-light .ace_cursor {\
color: #2563eb\
}\
.ace-jdoodle-light .ace_marker-layer .ace_selection {\
background: rgba(37, 99, 235, 0.14)\
}\
.ace-jdoodle-light.ace_multiselect .ace_selection.ace_start {\
box-shadow: 0 0 3px 0px #fdfdfe;\
}\
.ace-jdoodle-light .ace_marker-layer .ace_step {\
background: rgb(253, 230, 138)\
}\
.ace-jdoodle-light .ace_marker-layer .ace_bracket {\
margin: -1px 0 0 -1px;\
border: 1px solid rgba(37, 99, 235, 0.4)\
}\
.ace-jdoodle-light .ace_marker-layer .ace_active-line {\
background: rgba(15, 23, 42, 0.035)\
}\
.ace-jdoodle-light .ace_gutter-active-line {\
