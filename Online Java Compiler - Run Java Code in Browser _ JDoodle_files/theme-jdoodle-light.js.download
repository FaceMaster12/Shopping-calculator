}\
.ace-jdoodle-light .ace_support.ace_function,\
.ace-jdoodle-light .ace_support.ace_class,\
.ace-jdoodle-light .ace_entity.ace_name.ace_function,\
.ace-jdoodle-light .ace_entity.ace_name.ace_tag {\
color: #2563eb\
}\
.ace-jdoodle-light .ace_variable,\
.ace-jdoodle-light .ace_variable.ace_parameter,\
.ace-jdoodle-light .ace_identifier,\
.ace-jdoodle-light .ace_entity.ace_other.ace_attribute-name {\
color: #1e293b\
}\
.ace-jdoodle-light .ace_string {\
color: #047857\
}\
.ace-jdoodle-light .ace_string.ace_regexp {\
color: #047857\
}\
.ace-jdoodle-light .ace_comment {\
font-style: italic;\
color: #5c6b8a\
}\
.ace-jdoodle-light .ace_heading,\
.ace-jdoodle-light .ace_markup.ace_heading {\
color: #047857\
}\
.ace-jdoodle-light .ace_indent-guide {\
background: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAACCAYAAACZgbYnAAAAEklEQVQImWNgYGBgYHB3d/8PAAOIAdULw8qMAAAAAElFTkSuQmCC) right repeat-y\
}";
  var dom = require("ace/lib/dom");
  dom.importCssString(exports.cssText, exports.cssClass, false);
});
