color: #1e293b\
}\
.ace-jdoodle-light .ace_marker-layer .ace_selected-word {\
border: 1px solid rgba(37, 99, 235, 0.3)\
}\
.ace-jdoodle-light .ace_invisible {\
color: #cbd5e1\
}\
.ace-jdoodle-light .ace_keyword,\
.ace-jdoodle-light .ace_meta,\
.ace-jdoodle-light .ace_storage {\
color: #7c3aed\
}\
.ace-jdoodle-light .ace_keyword.ace_operator,\
.ace-jdoodle-light .ace_punctuation {\
color: #475569\
}\
.ace-jdoodle-light .ace_constant.ace_character,\
.ace-jdoodle-light .ace_constant.ace_language,\
.ace-jdoodle-light .ace_constant.ace_numeric,\
.ace-jdoodle-light .ace_constant.ace_other {\
