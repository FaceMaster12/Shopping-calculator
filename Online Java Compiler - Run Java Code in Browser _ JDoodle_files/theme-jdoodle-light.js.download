}\
.ace-jdoodle-light .ace_invalid {\
color: #dc2626;\
background-color: rgba(220, 38, 38, 0.1)\
}\
.ace-jdoodle-light .ace_invalid.ace_deprecated {\
color: #b45309;\
background-color: rgba(180, 83, 9, 0.1)\
}\
.ace-jdoodle-light .ace_support.ace_constant {\
